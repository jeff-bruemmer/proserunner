{:deps
 {org.clojure/clojure #:mvn{:version "1.12.0"},
  org.clojure/tools.cli #:mvn{:version "0.4.1"},
  org.babashka/http-client #:mvn{:version "0.4.22"},
  cheshire/cheshire #:mvn{:version "5.13.0"}},
 :paths ["src" "classes" "resources"],
 :aliases
 {:run
  {:main-opts ["-m" "proserunner.core"]}

  :test
  {:extra-paths ["test"],
   :extra-deps
   {clj-http-fake/clj-http-fake #:mvn{:version "1.0.3"},
    org.clojure/test.check #:mvn{:version "1.1.1"},
    com.cognitect/test-runner
    {:git/url "https://github.com/cognitect-labs/test-runner.git",
     :sha "209b64504cb3bd3b99ecfec7937b358a879f55c1"}},
   ;; test-helpers first: it moves user.home somewhere safe for the run
   :main-opts ["-e" "(require 'proserunner.test-helpers)" "-m" "cognitect.test-runner"]},
  :benchmark
  {:extra-paths ["."]
   :main-opts ["-m" "benchmarks.runner"]},
  :parallel-bench
  {:extra-paths ["."]
   :main-opts ["-m" "benchmarks.parallel"]},
  :scaling-bench
  {:extra-paths ["."]
   :main-opts ["-m" "benchmarks.scaling"]}}}
